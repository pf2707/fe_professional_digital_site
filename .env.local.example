# Copy to .env.local and fill in.

# The digital twin uses OpenRouter (https://openrouter.ai/keys).
OPENROUTER_API_KEY=sk-or-v1-...

# Firestore, where saved drafts and published CVs live. Firebase console →
# Project settings → Service accounts → Generate new private key. Paste the
# whole JSON file on ONE line, inside single quotes (a multi-line value isn't
# read). Leave it empty while developing: everything is then saved to .data/.
FIREBASE_ADMIN_CREDENTIALS='{"type":"service_account","project_id":"...",...}'

# Sign-in (email/password and Google). Firebase console → Project settings →
# General → Your apps → add a Web app, then copy these from its config. They are
# public by design: they identify the project, they don't grant access.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=

# The site owner's sign-in at /owner, where pending CVs are reviewed and
# approved. Not a Firebase account. Use a long password; changing it signs out
# every owner session.
OWNER_EMAIL=owner@shinhanasolution.com
OWNER_PASSWORD=
